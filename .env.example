# Deployment variable reference; deploy does not import this file or .env.
# Set these in the hosting provider's environment/secret settings.
SPRING_PROFILES_ACTIVE=deploy
PORT=8080
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=your-database
PGUSER=your-database-user
PGPASSWORD=replace-with-your-database-password
GOOGLE_WEB_CLIENT_ID=replace-with-your-google-web-client-id
# true for a new/Flyway-managed database; false for a schema without Flyway history.
DEPLOY_MIGRATIONS_ENABLED=true
