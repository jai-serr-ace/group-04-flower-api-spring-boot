# Optional ISOLATED database overrides. Copy to .env.local only if you want
# a separate local database instead of the working Railway settings in .env.
# This file is read as Java properties: do not wrap values in quotes.
PORT=8080
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=flowerdb
LOCAL_DB_USER=floweruser
LOCAL_DB_PASSWORD=flowerpassword
LOCAL_DB_SSLMODE=disable
LOCAL_MIGRATIONS_ENABLED=true
# Replace this to test real Google sign-in locally.
GOOGLE_WEB_CLIENT_ID=local-testing-client-id
